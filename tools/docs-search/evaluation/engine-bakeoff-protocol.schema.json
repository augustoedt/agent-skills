{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augustoedt/agent-skills/tools/docs-search/evaluation/engine-bakeoff-protocol.schema.json",
  "title": "docs-search engine bake-off protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_tag",
    "status",
    "frozen_at",
    "scope",
    "toolchain",
    "contracts",
    "policy",
    "common_retrieval",
    "engines",
    "inputs",
    "model",
    "measurement",
    "budgets",
    "selection_rule",
    "consumed_holdout_block"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_tag": {
      "const": "engine-bakeoff-v1"
    },
    "status": {
      "const": "frozen-before-implementation"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "development-only"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "common_retrieval": {
      "$ref": "#/$defs/commonRetrieval"
    },
    "engines": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/engine"
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "lexical-bm25-v1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "sqlite-cache-bm25-v1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "fts5-v1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "local-embeddings-v1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "hybrid-rrf-v1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/input"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "stable-v1"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "public-agent-skills"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "corpus-001"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "corpus-002"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "corpus-003"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "selection_rule": {
      "$ref": "#/$defs/selectionRule"
    },
    "consumed_holdout_block": {
      "$ref": "#/$defs/holdoutBlock"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blake3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_source_revision",
        "base_tool_version",
        "rust_version",
        "cargo_version",
        "base_cargo_lock_sha256",
        "build_profile",
        "locked",
        "implementation_revision_policy",
        "dependencies"
      ],
      "properties": {
        "base_source_revision": {
          "const": "3d380311114281abfe64df00f12557ad42564d20"
        },
        "base_tool_version": {
          "const": "0.5.0"
        },
        "rust_version": {
          "const": "rustc 1.98.1 (48a229cea 2026-09-01)"
        },
        "cargo_version": {
          "const": "cargo 1.98.1 (797e8a9bc 2026-08-05)"
        },
        "base_cargo_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_profile": {
          "const": "release"
        },
        "locked": {
          "const": true
        },
        "implementation_revision_policy": {
          "const": "one-reviewed-bakeoff-harness-revision-recorded-by-every-report;cargo-build-locked;no-engine-specific-source-changes-between-runs"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_response",
        "query_dataset",
        "evaluation_report",
        "bakeoff_protocol",
        "bakeoff_report",
        "local_manifest",
        "fixture"
      ],
      "properties": {
        "search_response": {
          "const": 2
        },
        "query_dataset": {
          "const": 2
        },
        "evaluation_report": {
          "const": 2
        },
        "bakeoff_protocol": {
          "const": 1
        },
        "bakeoff_report": {
          "const": 1
        },
        "local_manifest": {
          "const": 1
        },
        "fixture": {
          "const": "stable-v1"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs_per_engine_input",
        "immutable_reports",
        "retuning_after_freeze",
        "default_engine",
        "default_may_change",
        "global_install_may_change",
        "holdouts_allowed",
        "max_finalists",
        "hash_canonicalization",
        "report_write_policy"
      ],
      "properties": {
        "runs_per_engine_input": {
          "const": 2
        },
        "immutable_reports": {
          "const": true
        },
        "retuning_after_freeze": {
          "const": false
        },
        "default_engine": {
          "const": "lexical-bm25-v1"
        },
        "default_may_change": {
          "const": false
        },
        "global_install_may_change": {
          "const": false
        },
        "holdouts_allowed": {
          "const": false
        },
        "max_finalists": {
          "const": 2
        },
        "hash_canonicalization": {
          "const": "sha256-raw-file-bytes;engine-config-sha256-rfc8785-json-canonicalization"
        },
        "report_write_policy": {
          "const": "create-new-0600-refuse-if-path-exists"
        }
      }
    },
    "commonRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_selection",
        "chunking",
        "normalization",
        "query_tokens",
        "limit",
        "recall_cutoff",
        "max_excerpt_chars",
        "max_results_per_path",
        "evidence_fields",
        "tie_break"
      ],
      "properties": {
        "corpus_selection": {
          "const": "regular UTF-8 Markdown only: root README.md/CLAUDE.md/AGENTS.md/pi-warden.md and docs/**/*.md; hidden entries excluded; git ignore/exclude honored; symlinks not followed"
        },
        "chunking": {
          "const": "one chunk per ATX heading section H1-H6 plus preamble; heading ancestry joined with >; headings inside fenced code ignored; line numbers one-based"
        },
        "normalization": {
          "const": "Unicode NFD; remove combining marks; lowercase; replace non-alphanumeric with space; collapse whitespace"
        },
        "query_tokens": {
          "const": "deduplicate in source order; remove fixed Portuguese-English stopword list unless that would remove every token"
        },
        "limit": {
          "const": 5
        },
        "recall_cutoff": {
          "const": 5
        },
        "max_excerpt_chars": {
          "const": 1200
        },
        "max_results_per_path": {
          "type": "null"
        },
        "evidence_fields": {
          "type": "array",
          "const": [
            "path",
            "heading",
            "line_start",
            "line_end",
            "file_hash",
            "chunk_hash",
            "excerpt"
          ]
        },
        "tie_break": {
          "const": "score-desc-path-asc-line-start-asc"
        }
      }
    },
    "engine": {
      "oneOf": [
        {
          "$ref": "#/$defs/lexicalEngine"
        },
        {
          "$ref": "#/$defs/sqliteEngine"
        },
        {
          "$ref": "#/$defs/fts5Engine"
        },
        {
          "$ref": "#/$defs/embeddingEngine"
        },
        {
          "$ref": "#/$defs/hybridEngine"
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visibility",
        "role",
        "root",
        "source_revision",
        "snapshot_manifest",
        "snapshot_manifest_sha256",
        "queries",
        "queries_sha256",
        "dataset_blake3",
        "queries_schema_version",
        "query_count",
        "files",
        "chunks",
        "corpus_fingerprint",
        "baseline_report",
        "baseline_report_sha256",
        "selected_markdown_dirty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(stable-v1|public-agent-skills|corpus-[0-9]{3,})$"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "role": {
          "const": "development"
        },
        "root": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/gitRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmpty"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_manifest_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "queries": {
          "$ref": "#/$defs/nonEmpty"
        },
        "queries_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "queries_schema_version": {
          "const": 2
        },
        "query_count": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "chunks": {
          "type": "integer",
          "minimum": 1
        },
        "corpus_fingerprint": {
          "$ref": "#/$defs/blake3"
        },
        "baseline_report": {
          "$ref": "#/$defs/nonEmpty"
        },
        "baseline_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_markdown_dirty": {
          "const": false
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/nonEmpty"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "license",
        "dimension",
        "max_tokens",
        "query_prefix",
        "passage_prefix",
        "pooling",
        "normalization",
        "similarity",
        "dtype",
        "runtime",
        "tokenizers",
        "artifacts",
        "artifacts_sha256_file"
      ],
      "properties": {
        "id": {
          "const": "intfloat/multilingual-e5-small"
        },
        "revision": {
          "const": "614241f622f53c4eeff9890bdc4f31cfecc418b3"
        },
        "license": {
          "const": "MIT"
        },
        "dimension": {
          "const": 384
        },
        "max_tokens": {
          "const": 512
        },
        "query_prefix": {
          "const": "query: "
        },
        "passage_prefix": {
          "const": "passage: "
        },
        "pooling": {
          "const": "attention-mask-mean"
        },
        "normalization": {
          "const": "l2-f32-epsilon-1e-12"
        },
        "similarity": {
          "const": "f32-dot-product-on-l2-normalized-vectors"
        },
        "dtype": {
          "const": "f32"
        },
        "runtime": {
          "const": "candle-cpu-0.9.1"
        },
        "tokenizers": {
          "const": "0.21.1"
        },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            {
              "$ref": "#/$defs/modelConfigArtifact"
            },
            {
              "$ref": "#/$defs/modelTokenizerArtifact"
            },
            {
              "$ref": "#/$defs/modelWeightsArtifact"
            }
          ],
          "items": false
        },
        "artifacts_sha256_file": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "run_order",
        "fresh_process_per_phase",
        "warmup_queries",
        "prepare_policy",
        "query_policy",
        "incremental_workload",
        "memory_metric",
        "disk_metric",
        "latency_clock",
        "determinism_projection",
        "percentile_method",
        "process_environment",
        "rss_collector",
        "disk_collector",
        "os_cache_policy",
        "fault_injection"
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/host"
        },
        "run_order": {
          "type": "array",
          "const": [
            [
              "lexical-bm25-v1",
              "sqlite-cache-bm25-v1",
              "fts5-v1",
              "local-embeddings-v1",
              "hybrid-rrf-v1"
            ],
            [
              "hybrid-rrf-v1",
              "local-embeddings-v1",
              "fts5-v1",
              "sqlite-cache-bm25-v1",
              "lexical-bm25-v1"
            ]
          ]
        },
        "fresh_process_per_phase": {
          "const": true
        },
        "warmup_queries": {
          "const": 0
        },
        "prepare_policy": {
          "const": "delete-engine-index-before-full-build;create-new-index-atomically;refuse-overwrite-of-report"
        },
        "query_policy": {
          "const": "one-fresh-release-process-per-engine-input-run;queries-in-dataset-order;no-result-cache;offline"
        },
        "incremental_workload": {
          "$ref": "#/$defs/incrementalWorkload"
        },
        "memory_metric": {
          "const": "maximum-resident-set-size-bytes"
        },
        "disk_metric": {
          "const": "allocated-index-bytes-plus-shared-model-bytes-reported-separately"
        },
        "latency_clock": {
          "const": "monotonic"
        },
        "determinism_projection": {
          "const": "ordered-query-id-rank-path-heading-line-start-line-end-file-hash-chunk-hash-excerpt-sha256"
        },
        "percentile_method": {
          "const": "nearest-rank-index-ceil(p*n)-1-on-ascending-samples"
        },
        "process_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "RAYON_NUM_THREADS",
            "TOKENIZERS_PARALLELISM",
            "OMP_NUM_THREADS",
            "VECLIB_MAXIMUM_THREADS"
          ],
          "properties": {
            "RAYON_NUM_THREADS": {
              "const": "1"
            },
            "TOKENIZERS_PARALLELISM": {
              "const": "false"
            },
            "OMP_NUM_THREADS": {
              "const": "1"
            },
            "VECLIB_MAXIMUM_THREADS": {
              "const": "1"
            }
          }
        },
        "rss_collector": {
          "const": "macos-/usr/bin/time--l-maximum-resident-set-size-bytes-per-fresh-process"
        },
        "disk_collector": {
          "const": "logical=sum-st_size;allocated=sum-st_blocks-times-512;regular-index-files-only;shared-model-separate"
        },
        "os_cache_policy": {
          "const": "do-not-flush-os-page-cache;counterbalanced-engine-order;record-load-average-at-run-start"
        },
        "fault_injection": {
          "$ref": "#/$defs/faultInjection"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "safety",
        "context",
        "latency_ms",
        "indexing_ms",
        "resources_bytes"
      ],
      "properties": {
        "quality": {
          "$ref": "#/$defs/qualityBudgets"
        },
        "safety": {
          "$ref": "#/$defs/safetyBudgets"
        },
        "context": {
          "$ref": "#/$defs/contextBudgets"
        },
        "latency_ms": {
          "$ref": "#/$defs/latencyBudgets"
        },
        "indexing_ms": {
          "$ref": "#/$defs/indexingBudgets"
        },
        "resources_bytes": {
          "$ref": "#/$defs/resourceBudgets"
        }
      }
    },
    "selectionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "eligible_if",
        "meaningful_gain",
        "domination",
        "maximum_finalists",
        "baseline_retention_allowed",
        "tie_break"
      ],
      "properties": {
        "method": {
          "const": "pareto-with-eliminatory-budgets"
        },
        "eligible_if": {
          "const": "all-eliminatory-budgets-pass-on-both-runs-and-all-five-development-inputs"
        },
        "meaningful_gain": {
          "$ref": "#/$defs/meaningfulGain"
        },
        "domination": {
          "const": "not-worse-beyond-meaningful-gain-thresholds-on-quality-context-latency-indexing-memory-disk-and-strictly-better-on-at-least-one-dimension"
        },
        "maximum_finalists": {
          "const": 2
        },
        "baseline_retention_allowed": {
          "const": true
        },
        "tie_break": {
          "type": "array",
          "const": [
            "recall-at-5-macro",
            "hit-at-1",
            "mrr-at-5",
            "semantic-recall-at-5",
            "query-p95",
            "startup",
            "peak-rss",
            "index-bytes",
            "engine-id-ascending"
          ]
        }
      }
    },
    "holdoutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denylist",
        "denylist_sha256",
        "runner_enforcement",
        "contents_opened_during_freeze"
      ],
      "properties": {
        "denylist": {
          "$ref": "#/$defs/nonEmpty"
        },
        "denylist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_enforcement": {
          "const": "deny-before-manifest-role-or-query-path-resolution"
        },
        "contents_opened_during_freeze": {
          "const": false
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "cpu",
        "memory_bytes",
        "logical_cpus",
        "os",
        "os_build",
        "architecture",
        "compiler"
      ],
      "properties": {
        "machine": {
          "$ref": "#/$defs/nonEmpty"
        },
        "cpu": {
          "$ref": "#/$defs/nonEmpty"
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "os": {
          "$ref": "#/$defs/nonEmpty"
        },
        "os_build": {
          "$ref": "#/$defs/nonEmpty"
        },
        "architecture": {
          "type": "string",
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "compiler": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "incrementalWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "operations",
        "order",
        "verification"
      ],
      "properties": {
        "source": {
          "const": "deterministic-copy-of-first-four-sorted-selected-markdown-files"
        },
        "operations": {
          "type": "array",
          "const": [
            "add",
            "modify",
            "rename",
            "remove"
          ]
        },
        "order": {
          "type": "array",
          "const": [
            "add",
            "modify",
            "rename",
            "remove"
          ]
