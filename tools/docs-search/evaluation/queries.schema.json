{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augustoedt/agent-skills/tools/docs-search/evaluation/queries.schema.json",
  "title": "docs-search evaluation queries",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "queries"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "corpus": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "query", "expected_paths"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": ["exact", "semantic", "ambiguous", "no_answer"]
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "expected_headings": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "default": {}
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "default": []
        },
        "disabled_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "no_answer"
              }
            },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "expected_paths": {
                "maxItems": 0
              },
              "expected_headings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "properties": {
              "expected_paths": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
